{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/plugins/agentmem/hooks/user-prompt-submit.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/plugins/agentmem/hooks/post-tool-use.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/plugins/agentmem/hooks/post-session.js"
          }
        ]
      }
    ]
  }
}

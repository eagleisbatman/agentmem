{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "am session start --agent claude-code 2>/dev/null || true; am context --query \"$PROMPT\" --format markdown 2>/dev/null || echo ''"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/plugins/agentmem/hooks/post-tool-use.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/plugins/agentmem/hooks/post-session.js"
          }
        ]
      }
    ]
  }
}
